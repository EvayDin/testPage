# 填入托管 PostgreSQL 的连接字符串（例如 Neon 的 pooled connection string）。
# 使用数据库服务商提供的 SSL 参数，不要关闭证书校验。
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# 本地开发地址。Vercel 中设为实际站点地址，如 https://your-app.vercel.app。
APP_ORIGIN=http://localhost:5173
# Vercel 自动启用 Secure Cookie；本地 HTTP 保持 false。
COOKIE_SECURE=false
# 后端监听配置
HOST=127.0.0.1
PORT=3000
